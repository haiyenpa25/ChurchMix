{
  "$comment": "Single source of truth for developer tools. Used by setup/install-tools.ps1 (no Node needed) and by the app (src/toolchain.js).",
  "tools": [
    {
      "id": "node",
      "label": "Node.js LTS",
      "purpose": "Chạy HAINGUYENCODER, hooks và scripts/verify.mjs của mọi dự án",
      "command": "node",
      "versionArgs": ["--version"],
      "install": { "type": "winget", "id": "OpenJS.NodeJS.LTS" },
      "pathCandidates": ["%ProgramFiles%\\nodejs"],
      "required": true
    },
    {
      "id": "git",
      "label": "Git",
      "purpose": "Quản lý mã nguồn, GitHub, stop hook kiểm tra thay đổi",
      "command": "git",
      "versionArgs": ["--version"],
      "install": { "type": "winget", "id": "Git.Git" },
      "pathCandidates": ["%ProgramFiles%\\Git\\cmd"],
      "required": true
    },
    {
      "id": "php",
      "label": "PHP 8.3",
      "purpose": "Dự án PHP / Laravel (nếu đã có XAMPP sẽ dùng PHP của XAMPP)",
      "command": "php",
      "versionArgs": ["--version"],
      "install": { "type": "winget", "id": "PHP.PHP.8.3" },
      "pathCandidates": ["C:\\xampp\\php", "D:\\xampp\\php", "E:\\xampp\\php", "%LOCALAPPDATA%\\Microsoft\\WinGet\\Links"]
    },
    {
      "id": "composer",
      "label": "Composer",
      "purpose": "Quản lý thư viện PHP / Laravel",
      "command": "composer",
      "versionArgs": ["--version", "--no-ansi"],
      "dependsOn": ["php"],
      "install": { "type": "composer" },
      "pathCandidates": ["%LOCALAPPDATA%\\HAINGUYENCODER\\bin"]
    },
    {
      "id": "python",
      "label": "Python 3",
      "purpose": "Dự án Python (FastAPI / Django)",
      "command": "python",
      "versionArgs": ["--version"],
      "install": {
        "type": "winget",
        "id": "Python.Python.3.12",
        "override": "/quiet InstallAllUsers=0 PrependPath=1 Include_launcher=1"
      },
      "pathCandidates": ["%LOCALAPPDATA%\\Programs\\Python\\Python312", "%LOCALAPPDATA%\\Programs\\Python\\Python312\\Scripts"]
    },
    {
      "id": "clasp",
      "label": "Google clasp",
      "purpose": "Đẩy code Google Apps Script từ máy lên",
      "command": "clasp",
      "versionArgs": ["--version"],
      "dependsOn": ["node"],
      "install": { "type": "npm", "package": "@google/clasp" },
      "pathCandidates": ["%APPDATA%\\npm"]
    },
    {
      "id": "xampp",
      "label": "XAMPP",
      "purpose": "Apache + MySQL + phpMyAdmin cho môi trường XAMPP (cần quyền Admin)",
      "detectPaths": ["C:\\xampp\\xampp-control.exe", "D:\\xampp\\xampp-control.exe", "E:\\xampp\\xampp-control.exe"],
      "install": { "type": "winget", "id": "ApacheFriends.Xampp.8.2" },
      "heavy": true
    },
    {
      "id": "docker",
      "label": "Docker Desktop",
      "purpose": "Môi trường Docker (cần quyền Admin, WSL2 và khởi động lại máy)",
      "command": "docker",
      "versionArgs": ["--version"],
      "install": { "type": "winget", "id": "Docker.DockerDesktop" },
      "pathCandidates": ["%ProgramFiles%\\Docker\\Docker\\resources\\bin"],
      "heavy": true
    },
    {
      "id": "chrome-devtools-mcp",
      "label": "Chrome DevTools MCP",
      "purpose": "Soi Console Logs, Network requests, Performance trace trực tiếp trên Google Chrome qua Antigravity MCP",
      "command": "chrome-devtools-mcp",
      "versionArgs": ["--version"],
      "dependsOn": ["node"],
      "install": { "type": "npm", "package": "chrome-devtools-mcp" },
      "pathCandidates": ["%APPDATA%\\npm"]
    },
    {
      "id": "playwright-mcp",
      "label": "Playwright MCP",
      "purpose": "Mở trình duyệt, click nút, điền form, kiểm tra giao diện và accessibility snapshot tự động",
      "command": "playwright-mcp",
      "versionArgs": ["--version"],
      "dependsOn": ["node"],
      "install": { "type": "npm", "package": "@playwright/mcp" },
      "pathCandidates": ["%APPDATA%\\npm"]
    }
  ],

  "stackRequirements": {
    "php": ["php"],
    "laravel": ["php", "composer"],
    "node": ["node"],
    "python": ["python"],
    "static": [],
    "appsscript": ["node", "clasp"]
  },
  "envRequirements": {
    "xampp": ["xampp"],
    "docker": ["docker"],
    "none": []
  }
}
