{
  "hainguyencoder-quality": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/post-edit-format.mjs",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/stop-quality-gate.mjs",
        "timeout": 240
      }
    ]
  }
}
