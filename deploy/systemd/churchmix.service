[Unit]
Description=ChurchMix X32 AI Sound Engineer Service
After=network.target sound.target

[Service]
Type=simple
User=churchmix
WorkingDirectory=/opt/churchmix
ExecStart=/usr/bin/python3 -m uvicorn apps.api.main:app --host 0.0.0.0 --port 8080 --log-level info
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=READ_ONLY_MODE=true

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
